# instantiateUfo: Create instance UFOs from a Glyphs or designspace file
rule instantiateUfo
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner fontmake -i "$instance_name" -o ufo $
      $fontmake_type $in $args $stamp
  description = instantiateUfo

# buildTTF: Build a TTF from a source file
rule buildTTF
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner fontmake --output-path $out -o ttf $
      $fontmake_type $in $args $stamp
  description = buildTTF

# autohint: Run gftools-autohint
rule autohint
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner gftools-autohint $args -o $out $in $stamp
  description = autohint

# fix: Run gftools-fix
rule fix
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner gftools-fix-font -o $out $args $in $stamp
  description = fix

# compress: Compress to webfont
rule compress
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner fonttools ttLib.woff2 compress -o $out $
      $in $stamp
  description = compress

# buildOTF: Build a OTF from a source file
rule buildOTF
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner fontmake --output-path $out -o otf $
      $fontmake_type $in $args $stamp
  description = buildOTF

# copy: Copy a file
rule copy
  command = $
      /Users/pathumego/src/github/mooniak/font-repos/font-directory/.venv/bin/python3.12 $
      -m gftools.builder.jobrunner cp $in $out $stamp
  description = copy

# Generating instance_ufos/Kaputa-Regular.ufo.json
build instance_ufos/Kaputa-Regular.ufo.json: instantiateUfo $
    Kaputa-Regular.glyphspackage
  operation = instantiateUfo
  instance_name = Kaputa Regular
  fontmake_type = -g
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --instance-dir instance_ufos
# Generating ../fonts/webfonts/Kaputa-Regular.woff2
build ../fonts/webfonts/Kaputa-Regular.woff2: compress $
    ../fonts/ttf/Kaputa-Regular.ttf
  operation = compress
# Generating /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpyods8yud
build /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpyods8yud: $
    buildTTF instance_ufos/Kaputa-Regular.ufo.json
  operation = buildTTF
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -u
  fontmake_args =  --verbose WARNING 
# Generating /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmp5d5eq5q7
build /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmp5d5eq5q7: $
    buildOTF instance_ufos/Kaputa-Regular.ufo.json
  operation = buildOTF
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -u
  fontmake_args =  --verbose WARNING 
# Generating /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpwk25xopa
build /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpwk25xopa: $
    autohint /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpyods8yud
  operation = autohint
  args = --fail-ok 
# Generating ../fonts/ttf/Kaputa-Regular.ttf
build ../fonts/ttf/Kaputa-Regular.ttf: fix $
    /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpwk25xopa
  operation = fix
  args = 
# Generating ../fonts/otf/Kaputa-Regular.otf
build ../fonts/otf/Kaputa-Regular.otf: fix $
    /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmp5d5eq5q7
  operation = fix
  args = 
default ../fonts/webfonts/Kaputa-Regular.woff2 ../fonts/otf/Kaputa-Regular.otf
